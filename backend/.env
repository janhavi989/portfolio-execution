# Kalpi Portfolio Execution Engine - Local Environment

APP_NAME=Kalpi Portfolio Execution Engine
DEBUG=false
SECRET_KEY=kalpi-super-secret-key-change-in-prod
DATABASE_URL=sqlite+aiosqlite:///./kalpi.db

# Set to false for LIVE trading with real broker APIs
# Set to true to simulate all orders (no real money)
PAPER_TRADING=false

WEBHOOK_URL=http://localhost:8000/api/v1/notifications/webhook-receiver
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MAX_ORDERS_PER_SECOND=5
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=2.0
